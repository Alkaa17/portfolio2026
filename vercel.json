{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(assets|_ds)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ],
  "rewrites": [
    { "source": "/aboutme", "destination": "/about" }
  ],
  "redirects": [
    { "source": "/about", "destination": "/aboutme", "permanent": true },
    { "source": "/about.html", "destination": "/aboutme", "permanent": true },
    { "source": "/resume.html", "destination": "/aboutme", "permanent": true },
    { "source": "/resume", "destination": "/aboutme", "permanent": true }
  ]
}
